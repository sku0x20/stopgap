FROM ghcr.io/graalvm/jdk-community:25.0.2 AS build
WORKDIR /project/stopgap
ENV GRADLE_USER_HOME=/build/.gradle
COPY ./ ./
RUN --mount=type=cache,target=${GRADLE_USER_HOME} ./gradlew --no-daemon :app:jar


FROM ghcr.io/graalvm/native-image-community:25.0.2-muslib AS buildnative
WORKDIR /project/stopgap
COPY --from=build /project/stopgap/build/app/libs/libs libs
COPY --from=build /project/stopgap/build/app/libs/stopgap-app.jar ./
RUN native-image --static --libc=musl -jar stopgap-app.jar


FROM scratch
WORKDIR /app/stopgap
COPY --from=buildnative /project/stopgap/stopgap-app ./
ENTRYPOINT ["/app/stopgap/stopgap-app"]
